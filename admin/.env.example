# ==============================================================================
# ROYALS MARINE - ADMIN ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Backend API URL (Do NOT include /api/v1 at the end)
# Local: http://localhost:5000
# Production: https://royalsmarine-tech-asm.onrender.com (or your Google Cloud Run URL)
VITE_API_URL=https://royalsmarine-tech-asm.onrender.com

# Mapbox Public Access Token (for Maps & Tracking)
VITE_MAPBOX_TOKEN=

# Google Maps JavaScript API Key (Optional)
VITE_GOOGLE_MAPS_API_KEY=
